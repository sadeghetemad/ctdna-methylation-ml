// ------------------------------------------------------------
// Local resources for nf-core/methylseq.
//
// nf-core asks for up to 12 CPUs and 72 GB per alignment job;
// resourceLimits caps every job at what this machine has.
// Change the values to match your machine.
// ------------------------------------------------------------

process {
    resourceLimits = [
        cpus: 8,
        memory: 28.GB,
        time: 72.h
    ]
}
