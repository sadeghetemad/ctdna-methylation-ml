// ------------------------------------------------------------
// nfcore-gpu mode: additions to config/methylseq.config for
// bwa-meth on the GPU (Parabricks fq2bammeth) and MethylDackel.
//
// The GPU itself is requested by the pipeline's own `gpu` profile,
// which 03_process_nfcore.py adds to -profile.
// ------------------------------------------------------------

process {
    // Same calls as the Bismark modes: CpG context only (04 reads CpGs),
    // and without the first 10 bp of R2 (end-repair artifact of the
    // ELSA library prep; IGNORE_R2_END in scripts/utils.py). The
    // values are --nOT/--nOB R1-start,R1-end,R2-start,R2-end.
    withName: METHYLDACKEL_EXTRACT {
        ext.args = '--nOT 0,0,10,0 --nOB 0,0,10,0'
    }
}
