// ------------------------------------------------------------
// nf-core/methylseq on AWS Batch (03_process_nfcore.py --aws-batch).
//
// Each task is one Batch job on its own Spot instance, so the samples run
// in parallel. The queue, region and job role come from the environment
// variables printed by `terraform output -raw env_exports`.
// Used together with config/methylseq.config; the limits below replace its
// local-machine limits.
// ------------------------------------------------------------

process {
    executor = 'awsbatch'
    // First attempt on Spot; retries on the on-demand queue, which is not reclaimed
    queue    = { task.attempt > 1 && System.getenv('CTDNA_BATCH_QUEUE_ONDEMAND') ? System.getenv('CTDNA_BATCH_QUEUE_ONDEMAND') : System.getenv('CTDNA_BATCH_QUEUE') }

    // Largest job: 16 CPUs, 56 GB (fits an m6i.4xlarge with room for ECS)
    resourceLimits = [
        cpus: 16,
        memory: 56.GB,
        time: 72.h
    ]

    // A job whose Spot hosts were all reclaimed has no exit code (Integer.MAX_VALUE)
    errorStrategy = { task.exitStatus == null || task.exitStatus in ((130..145) + 104 + Integer.MAX_VALUE) ? 'retry' : 'finish' }
    maxRetries    = 3
}

aws {
    region = System.getenv('AWS_REGION')

    batch {
        // aws cli installed on the instances by the launch template
        cliPath              = '/home/ec2-user/miniconda/bin/aws'
        jobRole              = System.getenv('CTDNA_BATCH_JOB_ROLE')
        maxSpotAttempts      = 2
        maxTransferAttempts  = 5
        delayBetweenAttempts = '30 sec'
    }
}

executor {
    $awsbatch {
        queueSize       = 200
        submitRateLimit = '20 / 1 sec'
    }
}
