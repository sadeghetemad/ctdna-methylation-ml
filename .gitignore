# ------------------------------------------------------------
# Only code and the input files needed to run it are tracked.
# Everything the pipeline generates is ignored.
# ------------------------------------------------------------

# Large data and reference (steps 01-03)
/data/
/reference/
/logs/

# Generated outputs (steps 04-07 and notebooks)
/features/
/results/
/notebooks/data/

# Generated metadata (step 01) -- keep only the raw inputs
/metadata/*
!/metadata/raw/
!/metadata/publication/

# Nextflow run from the project root (nfcore mode itself uses data/nfcore/)
/work/
/.nextflow/
/.nextflow.log*

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/

# Temporary files
*.tmp.*

# OS / editor
.DS_Store
.vscode/
.idea/
